# Render Dashboard → Environment Variables (repoya gerçek anahtar koymayın)
# Yerel: cp render/.env.example .env && npm run dev:render

# DeepL çeviri (/api/translate) — üretimde zorunlu
DEEPL_AUTH_KEY=

# SEO API (/api/seo-optimize) — kullanıyorsanız zorunlu
ANTHROPIC_API_KEY=

# İsteğe bağlı
# SEO_MODEL=claude-haiku-4-5-20251001
# SEO_MAX_TOKENS=8192
# CORS_ORIGIN=*
# DEEPL_API_URL=https://api.deepl.com/v2/translate
