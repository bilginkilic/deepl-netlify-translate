generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  COUPLE
  GUEST
}

enum RsvpStatus {
  PENDING
  ATTENDING
  DECLINED
  MAYBE
}

enum MessageType {
  TEXT
  VIDEO
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          UserRole  @default(GUEST)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  weddingsOwned Wedding[] @relation("CoupleWeddings")
  guestProfiles Guest[]
  photosUploaded Photo[] @relation("PhotoUploader")
  messages       Message[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Wedding {
  id          String   @id @default(cuid())
  coupleUserId String
  title       String
  slug        String   @unique
  date        DateTime
  venueName   String?
  venueAddress String? @db.Text
  venueCity   String?
  venuePostcode String?
  description String?  @db.Text
  schedule    Json?
  settings    Json?
  coverImageUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  couple User @relation("CoupleWeddings", fields: [coupleUserId], references: [id], onDelete: Cascade)
  guests Guest[]
  photos Photo[]
  messages Message[]
  giftRegistryItems GiftRegistryItem[]
}

model Guest {
  id                String     @id @default(cuid())
  weddingId         String
  userId            String?
  email             String
  name              String
  rsvpStatus        RsvpStatus @default(PENDING)
  partySize         Int        @default(1)
  dietaryNotes      String?
  inviteToken       String     @unique @default(cuid())
  referencePhotoUrl String?
  faceId            String?
  consentFacialAt   DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  wedding   Wedding    @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  photoTags PhotoTag[]
  messages  Message[]

  @@unique([weddingId, email])
  @@index([weddingId])
}

model Photo {
  id          String   @id @default(cuid())
  weddingId   String
  uploaderId  String?
  s3Key       String
  s3Url       String
  caption     String?
  takenAt     DateTime?
  isProcessed Boolean  @default(false)
  createdAt   DateTime @default(now())

  wedding  Wedding    @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  uploader User?      @relation("PhotoUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  tags     PhotoTag[]

  @@index([weddingId, takenAt])
}

model PhotoTag {
  id              String  @id @default(cuid())
  photoId         String
  guestId         String
  confidenceScore Float

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([photoId, guestId])
}

model Message {
  id         String      @id @default(cuid())
  weddingId  String
  guestId    String?
  userId     String?
  type       MessageType
  body       String?     @db.Text
  contentUrl String?
  createdAt  DateTime    @default(now())

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guest   Guest?  @relation(fields: [guestId], references: [id], onDelete: SetNull)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([weddingId])
}

model GiftRegistryItem {
  id        String   @id @default(cuid())
  weddingId String
  title     String
  url       String?
  priceGbp  Decimal? @db.Decimal(10, 2)
  isClaimed Boolean  @default(false)
  claimedBy String?
  createdAt DateTime @default(now())

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}
