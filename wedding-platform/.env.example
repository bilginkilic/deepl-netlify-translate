# Database (PostgreSQL — Railway, Supabase, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/wedding_platform"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AWS — photos & facial recognition (Phase 2–3, prefer eu-west-2 London)
AWS_REGION="eu-west-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# Redis — BullMQ photo jobs (Phase 2–3)
REDIS_URL=""

# Email — Resend or SendGrid
RESEND_API_KEY=""

# Stripe UK — Phase 5
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
