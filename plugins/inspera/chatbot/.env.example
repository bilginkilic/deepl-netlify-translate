# Copy these lines into your October CMS project root `.env` (not committed).

ANTHROPIC_API_KEY=

# Model (default plugin config uses Haiku for lower cost — omit to use defaults)
# INSPERA_CHATBOT_MODEL=claude-haiku-4-5
# Pinned Haiku snapshot: INSPERA_CHATBOT_MODEL=claude-haiku-4-5-20251001
# Higher quality (higher cost): INSPERA_CHATBOT_MODEL=claude-sonnet-4-6
# Deprecated by Anthropic; avoid: claude-sonnet-4-20250514 (retirement announced)

# Token / history caps (defaults are cost-conscious; raise if needed)
# INSPERA_CHATBOT_MAX_TOKENS=400
# INSPERA_CHATBOT_MAX_MESSAGES=24
# INSPERA_CHATBOT_MAX_MESSAGE_CHARS=4000
